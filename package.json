{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create afmc-picklehub",
    "d1:execute": "wrangler d1 execute afmc-picklehub --file=schema.sql"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "hono": "^4.13.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.2",
    "wrangler": "^4.136.1"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
